{
  "uid": "pipeline",
  "title": "Pipeline",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "tags": [
    "sports-notifier"
  ],
  "annotations": {
    "list": [
      {
        "name": "Chaos faults",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "target": {
          "type": "tags",
          "tags": [
            "chaos"
          ],
          "matchAny": false,
          "limit": 200
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Push latency, poller → gateway",
      "description": "Time from the poller seeing a play (detectedAt) to the gateway writing the push to the user's socket. Dots are exemplars: click one to open that play's trace in Tempo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "5s",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(pipeline_latency_seconds_bucket{stage=\"gateway\"}[30s])))",
          "legendFormat": "p50",
          "exemplar": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pipeline_latency_seconds_bucket{stage=\"gateway\"}[30s])))",
          "legendFormat": "p99",
          "exemplar": true,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.999, sum by (le) (rate(pipeline_latency_seconds_bucket{stage=\"gateway\"}[30s])))",
          "legendFormat": "p99.9",
          "exemplar": false,
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Time since the poller saw it, per stage",
      "description": "p99 of the same clock at each stage: accepted (Event Processing), stage1, stage2, gateway. The gap between two lines is that hop's cost.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "5s",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, stage) (rate(pipeline_latency_seconds_bucket[30s])))",
          "legendFormat": "{{stage}}",
          "exemplar": false,
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Kafka lag",
      "description": "Messages written that the group has not committed yet, from Strimzi's Kafka exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "5s",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag{consumergroup=~\"stage1|stage2|history\"})",
          "legendFormat": "{{consumergroup}}",
          "exemplar": false,
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Throughput",
      "description": "Plays the accept script took, and pushes the gateways wrote to sockets.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "5s",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(plays_accepted_total{result=\"accepted\"}[30s]))",
          "legendFormat": "plays accepted /s",
          "exemplar": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(socket_sends_total[30s]))",
          "legendFormat": "pushes sent /s",
          "exemplar": false,
          "range": true
        }
      ]
    }
  ]
}
